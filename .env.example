# ==============================================================================
# Automated Market Data Platform - Environment Configuration Template
# ==============================================================================

# Database Configuration (MySQL / SQLite)
USE_SQLITE=true
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=market_analytics
SQLITE_DB_PATH=data/market_analytics.db

# Scraper Settings
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
SCRAPER_TIMEOUT_SECONDS=15
SCRAPER_MAX_RETRIES=3
SCRAPER_RETRY_BACKOFF=2.0
SCRAPER_RATE_LIMIT_DELAY=0.5

# Financial REST API Settings (Optional)
API_KEY=your_api_key_here
API_URL=https://api.example.com/v1/market

# Google Sheets Integration (Optional)
GOOGLE_SHEETS_CREDENTIALS_PATH=config/service_account.json
GOOGLE_SHEET_NAME=Market Analytics Dashboard

# Storage Paths & Logging
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_QUARANTINE_DIR=data/quarantine
REPORTS_DIR=reports/output
LOG_FILE_PATH=pipeline.log
LOG_LEVEL=INFO
