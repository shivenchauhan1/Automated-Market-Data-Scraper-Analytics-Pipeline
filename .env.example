# ==============================================================================
# Automated Market Data Scraper & Analytics Pipeline Configuration
# ==============================================================================

# Database Configuration (MySQL / SQLite)
# DB_TYPE: "mysql" or "sqlite" (Default: "sqlite" for portable out-of-the-box run)
DB_TYPE=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=market_analytics
SQLITE_DB_PATH=data/market_analytics.db

# Scraper Settings
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
SCRAPER_TIMEOUT_SECONDS=15
SCRAPER_MAX_RETRIES=3
SCRAPER_RETRY_BACKOFF=2.0
SCRAPER_RATE_LIMIT_DELAY=1.0

# API Settings (Optional Financial API)
FINANCIAL_API_KEY=demo_api_key
FINANCIAL_API_URL=https://api.example.com/v1/market

# Google Sheets Integration (Optional)
GOOGLE_SHEETS_CREDENTIALS_PATH=config/service_account.json
GOOGLE_SHEET_NAME=Market Analytics Dashboard

# Reporting & Storage Paths
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
REPORTS_DIR=reports/output
LOG_FILE_PATH=pipeline.log
LOG_LEVEL=INFO
