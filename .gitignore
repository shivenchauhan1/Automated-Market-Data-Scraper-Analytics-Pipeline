# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Caches and virtual environments
.pytest_cache/
.venv/
venv/
ENV/
env/

# Environment configurations and secret keys
.env
config/service_account.json
*.pem

# Local databases and runtime snapshots
data/database/*.db
data/*.db
data/raw/*
data/processed/*
data/quarantine/*
reports/output/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/quarantine/.gitkeep
!reports/output/.gitkeep

# Logs
*.log
pipeline.log

# IDE & agent scratch dirs
.agents/
.claude/
